{
  "expo": {
    "name": "Chess Arena",
    "slug": "chess-arena",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pradiphivare.chessarena",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#101713"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#101713",
      "barStyle": "light-content",
      "visible": "immersive-sticky"
    }
  }
}
