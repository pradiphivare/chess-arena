{
  "name": "chess-arena",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo start --android --clear",
    "ios": "expo start --ios --clear",
    "web": "expo start --web --clear",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "upgrade:expo": "npx expo install expo@latest && npx expo install --fix && npx expo install react-dom react-native-web"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "expo": "~58.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
